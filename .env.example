# Firebase web SDK configuration.
#
# These values are intentionally public — they are shipped in the
# browser bundle and are not secrets. They are sourced from environment
# variables so the same build can target different Firebase projects.
#
# To run locally:
#   1. Create a Firebase web app in the Firebase console for the project
#      you want to point at.
#   2. Copy this file to `.env.local`:
#        cp .env.example .env.local
#   3. Paste the values from the Firebase console into `.env.local`.
#   4. Start the dev server:  bun run dev
#
# Vite only exposes variables prefixed with `VITE_` to client code. Do
# not put server-only secrets (Groq key, service account JSON, etc.)
# in this file.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
