rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(resource) { return signedIn() && resource.data.userId == request.auth.uid; }

    match /documents/{documentId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read, delete: if owns(resource);
      allow update: if owns(resource) && request.resource.data.userId == request.auth.uid;
      match /messages/{messageId} {
        allow read: if signedIn() && get(/databases/$(database)/documents/documents/$(documentId)).data.userId == request.auth.uid;
        allow create: if signedIn() && request.resource.data.userId == request.auth.uid && get(/databases/$(database)/documents/documents/$(documentId)).data.userId == request.auth.uid;
      }
    }

    match /symptomReports/{reportId} {
      allow read, delete: if owns(resource);
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if owns(resource) && request.resource.data.userId == request.auth.uid;
    }

    // Public research data — anyone can read published papers and site content
    match /papers/{paperId} {
      allow read: if true;
      // Writes come from Cloud Functions (admin SDK), not client-side
      allow create, update, delete: if false;
    }

    match /siteContent/{docId} {
      allow read: if true;
      allow create, update, delete: if false;
    }
  }
}
